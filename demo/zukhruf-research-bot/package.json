    "@zukhruf/sqlite-open": "^0.8.12",
    "ai": "^7.0.166",
    "just-bash": "^3.6.0",
    "pg-boss": "^12.29.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.10",
    "hono": "^4.12.33"
  },
  "scripts": {
    "start": "node --env-file=../../.env server.ts",
    "prestart": "cd ../.. && nx run @deepagents/devtool:build"
