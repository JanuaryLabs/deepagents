{
  "name": "@deepagents/elements",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/elements/src",
  "projectType": "library",
  "tags": ["scope:public"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "external": ["react", "zod"]
      }
    },
    "test": {
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/elements.xml"],
      "options": {
        "command": "node ../../tools/src/run-node-tests.ts ../../test-results/elements.xml",
        "cwd": "{projectRoot}"
      }
    }
  }
}
