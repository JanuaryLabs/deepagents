{
  "name": "@deepagents/elements",
  "version": "6.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/deepagents",
    "directory": "packages/elements"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/deepagents/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/deepagents#readme",
  "type": "module",
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{workspaceRoot}/test-results/elements.xml"
        ],
        "options": {
          "command": "node ../../tools/src/run-node-tests.ts ../../test-results/elements.xml --test-force-exit"
        }
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js",
      "default": "./dist/context/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ai": "^7.0.85",
    "dedent": "^1.7.2",
    "htmlparser2": "^10.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepagents/context": "6.2.0"
  },
  "peerDependenciesMeta": {
    "@deepagents/context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepagents/context": "6.2.0"
  }
}
