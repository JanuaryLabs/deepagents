{
  "name": "@deepagents/toolbox",
  "version": "6.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/deepagents",
    "directory": "packages/toolbox"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/deepagents/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/deepagents#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/lib/*",
      "import": "./dist/lib/*",
      "default": "./dist/lib/*"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ai": "^7.0.30",
    "duck-duck-scrape": "^2.2.7",
    "lodash-es": "^4.18.1",
    "nano-spawn": "^2.1.0",
    "zod": "^4.4.3",
    "fast-glob": "^3.3.3",
    "@deepagents/retrieval": "6.1.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13"
  }
}
