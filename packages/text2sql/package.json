    },
    "./posthog": {
      "types": "./dist/lib/adapters/posthog/index.d.ts",
      "import": "./dist/lib/adapters/posthog/index.js",
      "default": "./dist/lib/adapters/posthog/index.js"
    },
    "./duckdb": {
      "types": "./dist/lib/adapters/duckdb/index.d.ts",
      "import": "./dist/lib/adapters/duckdb/index.js",
      "default": "./dist/lib/adapters/duckdb/index.js"
    },
    "./synthesis": {
      "types": "./dist/lib/synthesis/index.d.ts",
