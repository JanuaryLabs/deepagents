{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.contract.ts",
    "src/**/*.fixture.ts"
  ],
  "include": ["src/**/*.ts", "../../global.d.ts"],
  "references": [
    {
      "path": "../context/tsconfig.lib.json"
    },
    {
      "path": "../test/tsconfig.lib.json"
    }
  ]
}
