{
  "name": "@deepagents/experimental",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/experimental/src",
  "projectType": "library",
  "tags": ["scope:public"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "additionalEntryPoints": [
          "packages/experimental/src/coding-agent-reminders/index.ts",
          "packages/experimental/src/zukhruf/index.ts"
        ],
        "assets": []
      }
    },
    "test": {
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/experimental.xml"],
      "options": {
        "command": "node ../../tools/src/run-node-tests.ts ../../test-results/experimental.xml --test-force-exit"
      }
    }
  }
}
