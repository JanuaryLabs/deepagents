{
  "name": "@deepagents/experimental",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/experimental/src",
  "projectType": "library",
  "tags": ["scope:public", "test:node"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "additionalEntryPoints": [
          "packages/experimental/src/coding-agent-reminders/index.ts",
          "packages/experimental/src/providers/codex/index.ts",
          "packages/experimental/src/providers/claude/index.ts",
          "packages/experimental/src/zukhruf/index.ts",
          "packages/experimental/src/zukhruf/plugins/mcp/index.ts",
          "packages/experimental/src/zukhruf/plugins/http/index.ts",
          "packages/experimental/src/zukhruf/plugins/conversation-scheduling/index.ts",
          "packages/experimental/src/zukhruf/plugins/schedules/index.ts",
          "packages/experimental/src/zukhruf/plugins/schedules/http.ts",
          "packages/experimental/src/zukhruf/plugins/uploads/index.ts",
          "packages/experimental/src/zukhruf/plugins/uploads/http.ts"
        ],
        "assets": []
      }
    },
    "test": {
      "options": {
        "args": ["--test-force-exit"]
      }
    }
  }
}
