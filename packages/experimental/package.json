{
  "name": "@deepagents/experimental",
  "version": "6.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/deepagents",
    "directory": "packages/experimental"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/deepagents/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/deepagents#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./coding-agent-reminders": {
      "types": "./dist/coding-agent-reminders/index.d.ts",
      "import": "./dist/coding-agent-reminders/index.js",
      "default": "./dist/coding-agent-reminders/index.js"
    },
    "./providers/codex": {
      "types": "./dist/providers/codex/index.d.ts",
      "import": "./dist/providers/codex/index.js",
      "default": "./dist/providers/codex/index.js"
    },
    "./zukhruf": {
      "types": "./dist/zukhruf/index.d.ts",
      "import": "./dist/zukhruf/index.js",
      "default": "./dist/zukhruf/index.js"
    },
    "./zukhruf/mcp": {
      "types": "./dist/zukhruf/plugins/mcp/index.d.ts",
      "import": "./dist/zukhruf/plugins/mcp/index.js",
      "default": "./dist/zukhruf/plugins/mcp/index.js"
    },
    "./zukhruf/http": {
      "types": "./dist/zukhruf/plugins/http/index.d.ts",
      "import": "./dist/zukhruf/plugins/http/index.js",
      "default": "./dist/zukhruf/plugins/http/index.js"
    },
    "./zukhruf/conversation-scheduling": {
      "types": "./dist/zukhruf/plugins/conversation-scheduling/index.d.ts",
      "import": "./dist/zukhruf/plugins/conversation-scheduling/index.js",
      "default": "./dist/zukhruf/plugins/conversation-scheduling/index.js"
    },
    "./zukhruf/schedules": {
      "types": "./dist/zukhruf/plugins/schedules/index.d.ts",
      "import": "./dist/zukhruf/plugins/schedules/index.js",
      "default": "./dist/zukhruf/plugins/schedules/index.js"
    },
    "./zukhruf/schedules/http": {
      "types": "./dist/zukhruf/plugins/schedules/http.d.ts",
      "import": "./dist/zukhruf/plugins/schedules/http.js",
      "default": "./dist/zukhruf/plugins/schedules/http.js"
    },
    "./zukhruf/uploads": {
      "types": "./dist/zukhruf/plugins/uploads/index.d.ts",
      "import": "./dist/zukhruf/plugins/uploads/index.js",
      "default": "./dist/zukhruf/plugins/uploads/index.js"
    },
    "./zukhruf/uploads/http": {
      "types": "./dist/zukhruf/plugins/uploads/http.d.ts",
      "import": "./dist/zukhruf/plugins/uploads/http.js",
      "default": "./dist/zukhruf/plugins/uploads/http.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/code-mode": "^1.0.42",
    "@ai-sdk/mcp": "2.0.41",
    "@ai-sdk/openai": "^4.0.67",
    "@deepagents/context": "6.2.0",
    "@deepagents/elements": "6.2.0",
    "@iarna/toml": "^2.2.5",
    "@napi-rs/keyring": "^2.1.0",
    "@opencoredev/loginwithchatgpt-core": "^0.2.0",
    "ai": "^7.0.85",
    "atomically": "^2.1.1",
    "cron-parser": "5.6.2",
    "cronstrue": "^3.24.0",
    "fast-content-type-parse": "^3.0.0",
    "hono": "^4.12.33",
    "just-bash": "^3.2.0",
    "pg-boss": "^12.29.0",
    "proper-lockfile": "^4.1.2",
    "rrule": "^2.8.1",
    "tiny-tfidf": "^1.0.0",
    "uuid": "^14.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.9",
    "@electric-sql/pglite": "^0.5.4",
    "@types/proper-lockfile": "^4.1.4",
    "just-bash": "^3.2.0"
  }
}
