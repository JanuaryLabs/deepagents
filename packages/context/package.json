    "pluralize": "^8.0.0",
    "stringcase": "^4.3.1",
    "tiny-tfidf": "^1.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@daytona/sdk": "2.0.0-alpha.13",
    "@sinonjs/fake-timers": "^15.4.0",
    "@types/debug": "^4.1.13",
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.20.0",
    "@zukhruf/parameterized-test": "^0.8.144",
    "microsandbox": "^0.7.16",
    "msw": "^3.0.8"
  },
  "peerDependencies": {
    "@daytona/sdk": "2.0.0-alpha.13",
    "microsandbox": "^0.7.16",
    "mssql": "^12.7.0",
    "pg": "^8.22.0"
  },
