    "@ai-sdk/sandbox-just-bash": "^1.0.193",
    "@ai-sdk/tool-bash": "^1.0.35",
    "@deepagents/agent": "7.16.0",
    "@zukhruf/async": "^0.8.144",
    "@zukhruf/docker": "^0.8.144",
    "@zukhruf/fs": "^0.8.144",
    "@zukhruf/sqlite-drift": "^0.8.144",
    "@zukhruf/sqlite-open": "^0.8.144",
    "@zukhruf/sqlite-transaction": "^0.8.144",
    "ai": "^7.0.181",
    "dedent": "^1.7.2",
    "fast-glob": "^3.3.3",
    "just-bash": "^3.6.0",
