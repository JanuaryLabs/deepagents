{
  "name": "@deepagents/context",
  "version": "6.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/deepagents",
    "directory": "packages/context"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/deepagents/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/deepagents#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./tracing": {
      "types": "./dist/lib/tracing/index.d.ts",
      "import": "./dist/lib/tracing/index.js",
      "default": "./dist/lib/tracing/index.js"
    },
    "./telemetry": {
      "types": "./dist/lib/telemetry/index.d.ts",
      "import": "./dist/lib/telemetry/index.js",
      "default": "./dist/lib/telemetry/index.js"
    },
    "./telemetry/file": {
      "types": "./dist/lib/telemetry/file/index.d.ts",
      "import": "./dist/lib/telemetry/file/index.js",
      "default": "./dist/lib/telemetry/file/index.js"
    },
    "./sandbox/strace": {
      "types": "./dist/lib/sandbox/strace/index.d.ts",
      "import": "./dist/lib/sandbox/strace/index.js",
      "default": "./dist/lib/sandbox/strace/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.11",
    "@ai-sdk/provider": "^4.0.3",
    "@deepagents/agent": "6.0.0",
    "ai": "^7.0.30",
    "chalk": "^5.6.2",
    "dedent": "^1.7.2",
    "fast-glob": "^3.3.3",
    "gpt-tokenizer": "^3.4.0",
    "just-bash": "^3.2.0",
    "nano-spawn": "^2.1.0",
    "pluralize": "^8.0.0",
    "stringcase": "^4.3.1",
    "tiny-tfidf": "^1.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@ai-sdk/openai": "^4.0.15"
  },
  "devDependencies": {
    "@daytona/sdk": "^0.198.0",
    "@types/debug": "^4.1.13",
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.20.0",
    "microsandbox": "^0.6.7",
    "nock": "^14.0.16"
  },
  "peerDependencies": {
    "@daytona/sdk": "^0.198.0",
    "@rivet-dev/agent-os-common": "^0.0.260331072558",
    "@rivet-dev/agent-os-core": ">=0.1.1",
    "microsandbox": "^0.6.7",
    "mssql": "^12.7.0",
    "pg": "^8.22.0"
  },
  "peerDependenciesMeta": {
    "@daytona/sdk": {
      "optional": true
    },
    "microsandbox": {
      "optional": true
    },
    "mssql": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "@rivet-dev/agent-os-core": {
      "optional": true
    },
    "@rivet-dev/agent-os-common": {
      "optional": true
    }
  }
}
