{
  "name": "@deepagents/context",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/context/src",
  "projectType": "library",
  "tags": ["test:node", "test:docker"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "additionalEntryPoints": [
          "packages/context/src/browser.ts",
          "packages/context/src/lib/tracing/index.ts",
          "packages/context/src/lib/telemetry/index.ts",
          "packages/context/src/lib/telemetry/file/index.ts",
          "packages/context/src/lib/sandbox/strace/index.ts"
        ],
        "assets": []
      }
    },
    "test": {
      "options": {
        "args": ["--test-force-exit"]
      }
    }
  }
}
