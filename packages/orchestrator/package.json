    "ai": "^7.0.30",
    "zod": "^4.4.3",
    "lodash-es": "^4.18.1",
    "@deepagents/retrieval": "6.1.1",
    "@deepagents/toolbox": "6.1.1",
    "p-limit": "^7.3.0",
    "@tavily/core": "^0.7.6",
    "dedent": "^1.7.2"
  },
