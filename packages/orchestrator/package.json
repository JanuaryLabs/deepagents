  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepagents/agent": "6.1.1",
    "@deepagents/context": "6.1.1",
    "@ai-sdk/groq": "^4.0.11",
