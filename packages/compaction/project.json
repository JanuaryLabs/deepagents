{
  "name": "@deepagents/compaction",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/compaction/src",
  "projectType": "library",
  "tags": ["scope:public"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": { "external": ["ai"] }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/compaction.xml"],
      "options": {
        "command": "node ../../tools/src/run-node-tests.ts ../../test-results/compaction.xml --test-timeout=10000 src/compact.integration.test.ts",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "command": "prettier --write {projectRoot}"
    }
  }
}
