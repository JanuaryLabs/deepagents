{
  "name": "@deepagents/compaction",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/compaction/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "external": ["ai"]
      }
    },
    "test": {
      "options": {
        "args": "--test-timeout=10000 \"src/**/*.test.ts\""
      }
    },
    "format": {
      "command": "prettier --write {projectRoot}"
    }
  }
}
