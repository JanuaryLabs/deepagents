{
  "name": "@deepagents/react-input",
  "version": "7.10.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/deepagents",
    "directory": "packages/react/input"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/styles.css",
    "COMPOSER_FEATURE_MATRIX.md",
    "!dist/spec/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@deepagents/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "@deepagents/source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./styles.css": {
      "import": "./src/styles.css",
      "default": "./src/styles.css"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.77.0"
  },
  "peerDependencies": {
    "@zukhruf/ui": "^0.8.41",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@sinonjs/fake-timers": "^15.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.0.3",
    "@zukhruf/ui": "^0.8.41",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "20.11.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "browserslist": [
    "Chrome >= 136",
    "Firefox >= 134",
    "Safari >= 18.2"
  ]
}
