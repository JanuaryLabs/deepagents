{
  "name": "@deepagents/react-shadcn",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react/shadcn/src",
  "projectType": "library",
  "tags": ["scope:public"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build --config vite.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/react-shadcn.xml"],
      "options": {
        "command": "node ../../../tools/src/run-node-tests.ts ../../../test-results/react-shadcn.xml tests/public-api.test.mjs",
        "cwd": "{projectRoot}"
      }
    }
  }
}
