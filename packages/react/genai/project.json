{
  "name": "@deepagents/react-genai",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react/genai/src",
  "projectType": "library",
  "tags": ["scope:public", "layer:app-agnostic"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build --config vite.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "dependsOn": ["build", "^typecheck"],
      "options": {
        "command": "tsc --build --emitDeclarationOnly",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": ["{workspaceRoot}/test-results/react-genai.xml"],
      "options": {
        "command": "vitest run --config vite.config.ts",
        "cwd": "{projectRoot}"
      }
    }
  }
}
