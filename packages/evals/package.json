    "directory": "packages/evals"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/deepagents/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/deepagents#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js",
      "default": "./dist/engine/index.js"
    },
    "./scorers": {
      "types": "./dist/scorers/index.d.ts",
      "import": "./dist/scorers/index.js",
      "default": "./dist/scorers/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js",
      "default": "./dist/store/index.js"
    },
    "./dataset": {
      "types": "./dist/dataset/index.d.ts",
      "import": "./dist/dataset/index.js",
      "default": "./dist/dataset/index.js"
    },
    "./comparison": {
      "types": "./dist/comparison/index.d.ts",
      "import": "./dist/comparison/index.js",
      "default": "./dist/comparison/index.js"
    },
    "./reporters": {
      "types": "./dist/reporters/index.d.ts",
      "import": "./dist/reporters/index.js",
      "default": "./dist/reporters/index.js"
    },
    "./evaluate": {
      "types": "./dist/evaluate/index.d.ts",
      "import": "./dist/evaluate/index.js",
      "default": "./dist/evaluate/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "openai": "^6.48.0"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "daisyui": "^5.6.18"
  }
}
