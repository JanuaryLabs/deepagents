{
  "name": "@deepagents/devtool-history",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/devtool/history/src",
  "projectType": "library",
  "tags": ["scope:public"],
  "targets": {
    "test": {
      "options": {
        "command": "node ../../../tools/src/run-node-tests.ts ../../../test-results/devtool-history.xml --test-timeout=10000 src/child-progress.integration.test.ts"
      }
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "packages/devtool/history/src/index.tsx",
        "external": ["@deepagents/react-shadcn", "lucide-react", "react"]
      }
    }
  }
}
