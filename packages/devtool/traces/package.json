{
  "name": "@deepagents/devtool-traces",
  "version": "6.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/deepagents",
    "directory": "packages/devtool/traces"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./http": {
      "development": "./src/http.ts",
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./ui": {
      "development": "./src/ui.tsx",
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "default": "./dist/ui.js"
    },
    "./styles.css": {
      "development": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "dependencies": {
    "@ai-sdk/otel": "1.0.85",
    "@deepagents/devtool-history": "6.2.0",
    "@deepagents/react-shadcn": "6.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "ai": "7.0.85",
    "hono": "^4.12.33",
    "lucide-react": "^1.33.0"
  },
  "peerDependencies": {
    "@deepagents/context": "6.2.0",
    "@deepagents/experimental": "6.2.0",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.9",
    "@deepagents/context": "6.2.0",
    "@deepagents/experimental": "6.2.0",
    "@types/react": "19.2.18",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "zod": "4.4.3"
  }
}
