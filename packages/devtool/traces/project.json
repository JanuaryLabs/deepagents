{
  "name": "@deepagents/devtool-traces",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/devtool/traces/src",
  "projectType": "library",
  "tags": ["scope:public"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "additionalEntryPoints": [
          "packages/devtool/traces/src/http.ts",
          "packages/devtool/traces/src/ui.tsx"
        ],
        "assets": [
          {
            "input": "packages/devtool/traces/src",
            "glob": "styles.css",
            "output": "."
          }
        ],
        "external": [
          "@deepagents/context",
          "@deepagents/devtool-history",
          "@deepagents/react-shadcn",
          "@deepagents/experimental",
          "hono",
          "lucide-react",
          "react"
        ]
      }
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/devtool-traces.xml"],
      "options": {
        "command": "node ../../../tools/src/run-node-tests.ts ../../../test-results/devtool-traces.xml",
        "cwd": "{projectRoot}"
      }
    }
  }
}
