{
  "name": "@deepagents/devtool-traces",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/devtool/traces/src",
  "projectType": "library",
  "tags": ["scope:public"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "additionalEntryPoints": ["packages/devtool/traces/src/ui.tsx"],
        "assets": [
          {
            "input": "packages/devtool/traces/src",
            "glob": "styles.css",
            "output": "."
          }
        ],
        "external": [
          "@deepagents/context",
          "@deepagents/devtool-history",
          "@deepagents/devtool-shadcn",
          "@deepagents/experimental",
          "hono",
          "lucide-react",
          "react"
        ]
      }
    }
  }
}
