{
  "name": "@deepagents/devtool-shadcn",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/devtool/shadcn/src",
  "projectType": "library",
  "tags": ["scope:public"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "assets": [
          {
            "input": "packages/devtool/shadcn/src",
            "glob": "styles.css",
            "output": "."
          }
        ],
        "external": [
          "@radix-ui/react-dialog",
          "@radix-ui/react-slot",
          "clsx",
          "lucide-react",
          "react",
          "tailwind-merge"
        ]
      }
    }
  }
}
