{
  "name": "@deepagents/devtool-shadcn",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/devtool/shadcn/src",
  "projectType": "library",
  "tags": ["scope:public"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
