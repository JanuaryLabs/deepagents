{
  "name": "@deepagents/devtool",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/devtool/host/src",
  "projectType": "library",
  "tags": ["test:node"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "dependsOn": [
        "^build",
        {
          "projects": ["@deepagents/devtool-ui"],
          "target": "build"
        }
      ],
      "options": {
        "additionalEntryPoints": ["packages/devtool/host/src/traces/index.ts"],
        "assets": [
          {
            "input": "packages/devtool/host/ui/dist",
            "glob": "**/*",
            "output": "ui"
          }
        ],
        "includeIgnoredAssetFiles": true
      }
    },
    "test": {}
  }
}
