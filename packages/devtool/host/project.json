{
  "name": "@deepagents/devtool",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/devtool/host/src",
  "projectType": "library",
  "tags": ["scope:public"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "dependsOn": [
        "^build",
        {
          "projects": ["@deepagents/devtool-ui"],
          "target": "build"
        }
      ],
      "options": {
        "assets": [
          {
            "input": "packages/devtool/host/ui/dist",
            "glob": "**/*",
            "output": "ui"
          }
        ],
        "includeIgnoredAssetFiles": true
      }
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/devtool.xml"],
      "options": {
        "command": "node ../../../tools/src/run-node-tests.ts ../../../test-results/devtool.xml --test-force-exit",
        "cwd": "{projectRoot}"
      }
    }
  }
}
