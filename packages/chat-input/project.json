{
  "name": "@deepagents/chat-input",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/chat-input/src",
  "projectType": "library",
  "tags": ["scope:public"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "additionalEntryPoints": ["packages/chat-input/src/browser.ts"],
        "assets": [
          {
            "input": "packages/chat-input/src",
            "glob": "styles.css",
            "output": "."
          }
        ],
        "external": [
          "@tiptap/core",
          "@tiptap/extension-link",
          "@tiptap/pm",
          "@tiptap/react",
          "@tiptap/starter-kit",
          "clsx",
          "lodash-es",
          "lucide-react",
          "radix-ui",
          "react",
          "react-dom",
          "tailwind-merge"
        ]
      }
    },
    "typecheck": {
      "dependsOn": ["build", "^typecheck"]
    },
    "test": {
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/chat-input.xml"],
      "options": {
        "command": "vitest run --config vite.config.ts",
        "cwd": "{projectRoot}"
      }
    }
  }
}
