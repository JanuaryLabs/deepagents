{
  "name": "@deepagents/agent",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/agent/src",
  "projectType": "library",
  "tags": ["scope:public"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/test-results/agent.xml"],
      "options": {
        "command": "node ../../tools/src/run-node-tests.ts ../../test-results/agent.xml --test-force-exit",
        "cwd": "{projectRoot}"
      }
    }
  }
}
