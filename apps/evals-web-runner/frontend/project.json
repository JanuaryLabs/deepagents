{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/evals-web-runner/frontend/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "options": {
        "args": ["--runExternalCode"]
      },
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "dependsOn": ["^build"]
    },
    "serve": {},
    "test": {
      "dependsOn": ["..."],
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{projectRoot}/test-output/vitest/coverage"
      ],
      "options": {
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../../coverage/apps/frontend"
      }
    }
  },
  "implicitDependencies": ["backend"]
}
