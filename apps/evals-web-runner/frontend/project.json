{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/evals-web-runner/frontend/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "dependsOn": ["^build", "backend:openapi"],
      "inputs": ["...", { "dependentTasksOutputFiles": "**/*" }]
    },
    "typecheck": {
      "options": { "args": ["--runExternalCode"] },
      "dependsOn": ["^typecheck", "backend:openapi"],
      "inputs": ["...", { "dependentTasksOutputFiles": "**/*" }]
    },
    "dev": {
      "dependsOn": ["^build", "backend:openapi"]
    },
    "serve": {
      "dependsOn": ["backend:openapi"]
    },
    "test": {
      "dependsOn": ["...", "backend:openapi"],
      "inputs": ["...", { "dependentTasksOutputFiles": "**/*" }],
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{projectRoot}/test-output/vitest/coverage"
      ],
      "options": {
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../../coverage/apps/frontend"
      }
    }
  }
}
