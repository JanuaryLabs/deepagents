                    "cases": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CaseWithScores"
                      }
                    },
                    "config": {
                      "type": "object",
                      "additionalProperties": {}
                    },
                    "run": {
                      "$ref": "#/components/schemas/RunRow"
                    },
                    "scorerNames": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "suite": {
                      "$ref": "#/components/schemas/SuiteRow"
                    },
                    "summary": {
                      "$ref": "#/components/schemas/RunSummary"
                    }
                  },
                  "required": [
                    "cases",
                    "config",
                    "run",
                    "scorerNames",
                    "suite",
                    "summary"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Response for 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate400_application_json"
                }
              }
            }
          },
          "404": {
            "description": "Response for 404",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "enum": [
                        "Run not found"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "415": {
            "description": "Response for 415",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate415_application_json"
                }
              }
            }
          },
          "500": {
            "description": "Response for 500",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "enum": [
                        "Suite not found for run"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "renameRun",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "tags": [
          "runs"
        ],
        "description": "Rename an existing run",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "name"
                ],
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response for 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "enum": [
                        true
                      ],
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
