{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent API",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "suites"
    },
    {
      "name": "runs"
    },
    {
      "name": "datasets"
    },
    {
      "name": "prompts"
    },
    {
      "name": "compare"
    },
    {
      "name": "models"
    }
  ],
  "paths": {
    "/suites": {
      "get": {
        "operationId": "listSuites",
        "parameters": [],
        "tags": [
          "suites"
        ],
        "description": "List all evaluation suites with run counts",
        "responses": {
          "200": {
            "description": "Response for 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "completedCount": {
                        "type": "number"
                      },
                      "created_at": {
                        "type": "number"
                      },
                      "failedCount": {
                        "type": "number"
                      },
                      "id": {
                        "type": "string"
                      },
                      "lastStartedAt": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "name": {
                        "type": "string"
                      },
                      "runCount": {
                        "type": "number"
                      },
                      "runningCount": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "completedCount",
                      "created_at",
                      "failedCount",
                      "id",
                      "lastStartedAt",
                      "name",
                      "runCount",
                      "runningCount"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Response for 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate400_application_json"
                }
              }
            }
          },
          "415": {
            "description": "Response for 415",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate415_application_json"
                }
              }
            }
          }
        }
      }
    },
    "/suites/{id}": {
      "get": {
        "operationId": "getSuite",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "tags": [
          "suites"
        ],
        "description": "Get a single suite with its runs and aggregate stats",
        "responses": {
          "200": {
            "description": "Response for 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "runs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RunRow"
                      }
                    },
                    "stats": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "totalCases": {
                              "type": "number"
                            },
                            "totalFail": {
                              "type": "number"
                            },
                            "totalLatency": {
                              "type": "number"
                            },
                            "totalPass": {
                              "type": "number"
                            },
                            "totalTokens": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "totalCases",
                            "totalFail",
                            "totalLatency",
                            "totalPass",
                            "totalTokens"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "suite": {
                      "$ref": "#/components/schemas/SuiteRow"
                    }
                  },
                  "required": [
                    "runs",
                    "stats",
                    "suite"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Response for 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate400_application_json"
                }
              }
            }
          },
          "404": {
            "description": "Response for 404",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "enum": [
                        "Suite not found"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "415": {
            "description": "Response for 415",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate415_application_json"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "renameSuite",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "tags": [
          "suites"
        ],
        "description": "Rename an existing suite",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "name"
                ],
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response for 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "enum": [
                        true
                      ],
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Response for 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate400_application_json"
                }
              }
            }
          },
          "404": {
            "description": "Response for 404",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "enum": [
                        "Suite not found"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "415": {
            "description": "Response for 415",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate415_application_json"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteSuite",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "tags": [
          "suites"
        ],
        "description": "Delete a suite and all its runs",
        "responses": {
          "204": {
            "description": "Response for 204"
          },
          "400": {
            "description": "Response for 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate400_application_json"
                }
              }
            }
          },
          "404": {
            "description": "Response for 404",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "enum": [
                        "Suite not found"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "415": {
            "description": "Response for 415",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate415_application_json"
                }
              }
            }
          }
        }
      }
    },
    "/suites/{id}/compare": {
      "get": {
        "operationId": "compareSuiteRuns",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "runIds",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "tags": [
          "suites"
        ],
        "description": "Compare multiple runs within a suite",
        "responses": {
          "200": {
            "description": "Response for 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "caseDiffs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": {
                            "type": "number"
                          },
                          "scores": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "number"
                              }
                            }
                          }
                        },
                        "required": [
                          "index",
                          "scores"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "runs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "model": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "summary": {
                            "$ref": "#/components/schemas/RunSummary"
                          }
                        },
                        "required": [
                          "id",
                          "model",
                          "name",
                          "summary"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "scorerNames": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "caseDiffs",
                    "runs",
                    "scorerNames"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Response for 400",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/validate400_application_json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "enum": [
                            "At least 2 run IDs required"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Response for 404",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "enum": [
                            "Suite not found"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "415": {
            "description": "Response for 415",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate415_application_json"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/events": {
      "get": {
        "operationId": "streamRunEvents",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "tags": [
          "runs"
        ],
        "description": "Stream real-time SSE events for a running eval",
        "responses": {
          "200": {
            "description": "Response for 200",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Response for 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate400_application_json"
                }
              }
            }
          },
          "415": {
            "description": "Response for 415",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate415_application_json"
                }
              }
            }
          }
        }
      }
    },
    "/runs": {
      "get": {
        "operationId": "listRuns",
        "parameters": [],
        "tags": [
          "runs"
        ],
        "description": "List all runs grouped by suite",
        "responses": {
          "200": {
            "description": "Response for 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "runs": {
                            "type": "array",
                            "items": {
                              "$ref": "#/components/schemas/RunRow"
                            }
                          },
                          "suiteId": {
                            "type": "string"
                          },
                          "suiteName": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "runs",
                          "suiteId",
                          "suiteName"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "totalRuns": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "groups",
                    "totalRuns"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Response for 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate400_application_json"
                }
              }
            }
          },
          "415": {
            "description": "Response for 415",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate415_application_json"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createRun",
        "parameters": [],
        "tags": [
          "runs"
        ],
        "description": "Start a new eval run across one or more models",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "dataset",
                  "models",
                  "name",
                  "scorers"
                ],
                "type": "object",
                "properties": {
                  "batchSize": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "x-zod-type": "coerce-number"
                  },
                  "dataset": {
                    "type": "string",
                    "minLength": 1
                  },
                  "endpointUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "expectedField": {
                    "type": "string"
                  },
                  "inputField": {
                    "type": "string"
                  },
                  "maxConcurrency": {
                    "default": 10,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "x-zod-type": "coerce-number"
                  },
                  "models": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\s/]+\\/[^\\s/].+$"
                    }
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "promptId": {
                    "type": "string"
                  },
                  "recordSelection": {
                    "type": "string"
                  },
                  "scorerModel": {
                    "type": "string"
                  },
                  "scorers": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "suiteId": {
                    "type": "string"
                  },
                  "taskMode": {
                    "default": "prompt",
                    "type": "string",
                    "enum": [
                      "prompt",
                      "http"
                    ]
                  },
                  "threshold": {
                    "default": 0.5,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "x-zod-type": "coerce-number"
                  },
                  "timeout": {
                    "default": 30000,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "x-zod-type": "coerce-number"
                  },
                  "trials": {
                    "default": 1,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "x-zod-type": "coerce-number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Response for 201",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "suiteId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "suiteId"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Response for 400",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/validate400_application_json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "enum": [
                            "HTTP mode requires an endpoint URL."
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "enum": [
                            "Prompt mode requires selecting a saved prompt."
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Response for 404",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "enum": [
                            "Selected prompt was not found."
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "enum": [
                            "Suite not found"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "415": {
            "description": "Response for 415",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/validate415_application_json"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}": {
      "get": {
        "operationId": "getRun",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "tags": [
          "runs"
        ],
        "description": "Get a single run with cases and scores",
        "responses": {
          "200": {
            "description": "Response for 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
